---
pagination:
  data: legacyLandingPages
  size: 1
  alias: landing
permalink: "{{ landing.url }}index.html"
layout: layouts/seo-landing.njk
status: published
index: true
eleventyComputed:
  title: "{{ landing.title | safe }}"
  description: "{{ landing.description | safe }}"
  canonical: "https://purebakes.in{{ landing.url }}"
  pageType: "{{ landing.pageType }}"
  pageSlug: "{{ landing.key }}"
  h1: "{{ landing.h1 | safe }}"
  eyebrow: "{{ landing.eyebrow | safe }}"
  intro: "{{ landing.intro | safe }}"
  pageContext: "{{ landing.h1 | safe }}"
  parentUrl: "/cakes/"
  parentLabel: "Cakes"
  breadcrumbLabel: "{{ landing.h1 | safe }}"
---

{% set portfolio = gallery | galleryByIds(landing.imageIds) %}
{% set portfolioGalleryKey = landing.galleryKey %}
{% set portfolioHeading = landing.portfolioHeading %}
{% set portfolioIntro = landing.portfolioIntro %}
{% include "components/legacy-seo-portfolio.njk" %}
{% for section in landing.sections %}
  <section class="seo-copy-block">
    <div>
      <p class="eyebrow">{{ section.eyebrow }}</p>
      <h2>{{ section.heading }}</h2>
      <p>{{ section.lead }}</p>
    </div>
    <div>
      {% for paragraph in section.paragraphs %}<p>
        {{ paragraph }}
      </p>{% endfor %}
    </div>
  </section>
{% endfor %}
<section class="seo-links">
  <div>
    <p class="eyebrow">Continue exploring</p>
    <h2>Related PureBakes pages</h2>
    <div class="seo-link-grid">
      {% for item in landing.relatedLinks %}<a href="{{ item.url }}"
        >{{ item.label }} <span>→</span></a
      >{% endfor %}
    </div>
  </div>
  <div>
    <p class="eyebrow">Across Hyderabad</p>
    <h2>Made for your celebration</h2>
    <p>
      Explore real cakes for inspiration, then share the date and details that
      matter for your own order.
    </p>
    <p>
      <a class="text-link" href="/areas-we-serve/">View Delivery Areas →</a>
    </p>
  </div>
</section>
{% set faqs = landing.faqs %}{% include "components/seo-faqs.njk" %}
<section class="seo-copy-block">
  <div>
    <p class="eyebrow">Plan your cake</p>
    <h2>Ready to check your date?</h2>
  </div>
  <div>
    <p>{{ landing.finalCta }}</p>
    <button
      class="button button--primary"
      data-availability-open
      data-cta-location="legacy_landing_final"
      {% if landing.occasionValue %}data-occasion="{{ landing.occasionValue }}"{% endif %}
    >
      Check Availability
    </button>
  </div>
</section>
