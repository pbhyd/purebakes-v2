---
pagination:
  data: themePages
  size: 1
  alias: landing
permalink: "{{ landing.url }}index.html"
layout: layouts/seo-landing.njk
pageType: theme
status: published
index: true
eleventyComputed:
  title: "{{ landing.title }}"
  description: "{{ landing.description }}"
  canonical: "https://purebakes.in{{ landing.url }}"
  pageSlug: "{{ landing.key }}"
  h1: "{{ landing.h1 }}"
  eyebrow: "Theme inspiration"
  intro: "{{ landing.intro }}"
  pageContext: "{{ landing.h1 }}"
  parentUrl: "/cakes/"
  parentLabel: "Cakes"
  grandparentUrl: "/cakes/themes/"
  grandparentLabel: "Cake Themes"
  breadcrumbLabel: "{{ landing.h1 }}"
---
{% set portfolio = gallery | galleryBy("themes", landing.key, 8) %}{% set portfolioHeading = landing.h1 + " from our portfolio" %}{% set portfolioIntro = "Explore real " + landing.h1 | lower + " created by PureBakes for birthdays and special celebrations." %}{% include "components/seo-portfolio.njk" %}
<section class="seo-copy-block"><div><p class="eyebrow">Design direction</p><h2>{{ landing.h1 }} for memorable celebrations</h2></div><div><p>{{ landing.ideas }}</p><p>Every design is made to order. We can adapt colour, tiering and finishing details while keeping the final composition personal to your celebration.</p></div></section>
<section class="seo-links"><div><p class="eyebrow">Related themes</p><h2>More visual directions</h2><div class="seo-link-grid">{% for key in landing.relatedThemes %}{% set item = themePages | findByKey(key) %}<a href="{{ item.url }}">{{ item.h1 }} <span>→</span></a>{% endfor %}</div></div><div><p class="eyebrow">Popular occasions</p><h2>Where this theme works</h2><div class="seo-link-grid">{% for key in landing.relatedOccasions %}{% set item = occasionPages | findByKey(key) %}{% if item %}<a href="{{ item.url }}">{{ item.h1 }} <span>→</span></a>{% endif %}{% endfor %}</div></div></section>
{% set faqs = [{question:"Can this theme be customized in different colours?",answer:"Yes. Palette, decorative balance and personalised details can be adjusted around your celebration."},{question:"Can I share a reference design?",answer:"Yes. References help communicate the direction you like; PureBakes will discuss how to adapt it into a made-to-order design."},{question:"Are egg and eggless cakes available?",answer:business.eggOptions},{question:"How do I check availability?",answer:"Select Check Availability and provide the required date. You will then continue to WhatsApp with the page context included."}] %}{% include "components/seo-faqs.njk" %}
