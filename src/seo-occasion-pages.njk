---
pagination:
  data: occasionPages
  size: 1
  alias: landing
permalink: "{{ landing.url }}index.html"
layout: layouts/seo-landing.njk
pageType: occasion
status: published
index: true
eleventyComputed:
  title: "{{ landing.title | safe }}"
  description: "{{ landing.description | safe }}"
  canonical: "https://purebakes.in{{ landing.url }}"
  pageSlug: "{{ landing.key }}"
  h1: "{{ landing.h1 | safe }}"
  eyebrow: "Made for the occasion"
  intro: "{{ landing.intro | safe }}"
  pageContext: "{{ landing.h1 | safe }}"
  parentUrl: "/cakes/"
  parentLabel: "Cakes"
  breadcrumbLabel: "{{ landing.h1 | safe }}"
---
{% set portfolio = gallery | occasionPortfolio(landing, 8) %}{% set portfolioHeading = landing.h1 + " from our studio" %}{% set portfolioIntro = landing.key | occasionPortfolioIntro %}{% include "components/seo-portfolio.njk" %}
<section class="seo-copy-block"><div><p class="eyebrow">Designed around you</p><h2>From reference to original design</h2></div><div><p>{{ landing.guidance }}</p><p>{{ business.eggOptions }} A 50% advance confirms the order, with the balance completed before pickup or before a delivery cab is booked.</p></div></section>
<section class="seo-links"><div><p class="eyebrow">Explore themes</p><h2>Related cake ideas</h2><div class="seo-link-grid">{% for key in landing.relatedThemes %}{% set item = themePages | findByKey(key) %}{% if item %}<a href="{{ item.url }}">{{ item.h1 }} <span>→</span></a>{% endif %}{% endfor %}</div></div><div><p class="eyebrow">Other celebrations</p><h2>Continue exploring</h2><div class="seo-link-grid">{% for key in landing.relatedOccasions %}{% set item = occasionPages | findByKey(key) %}{% if item %}<a href="{{ item.url }}">{{ item.h1 }} <span>→</span></a>{% endif %}{% endfor %}</div></div></section>
{% set faqs = [{question:"How far ahead should I enquire?",answer:"Availability depends on the date and design complexity. Share your required date first so the studio can confirm what is practical."},{question:"Can the design be personalized?",answer:"Yes. PureBakes cakes are made to order, and design details can be shaped around your palette, references and celebration."},{question:"Are eggless options available?",answer:business.eggOptions},{question:"How is the order confirmed?",answer:"A 50% advance confirms the order. The remaining 50% is completed before pickup or before a delivery cab is booked."}] %}{% include "components/seo-faqs.njk" %}
{% set faqStructuredData = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[]} %}
