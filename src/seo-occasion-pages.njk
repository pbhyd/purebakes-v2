---
pagination:
  data: occasionPages
  size: 1
  alias: landing
permalink: "{{ landing.url }}index.html"
layout: layouts/seo-landing.njk
pageType: occasion
status: published
index: true
eleventyComputed:
  title: "{{ landing.title | safe }}"
  description: "{{ landing.description | safe }}"
  canonical: "https://purebakes.in{{ landing.url }}"
  pageSlug: "{{ landing.key }}"
  h1: "{{ landing.h1 | safe }}"
  eyebrow: "Made for the occasion"
  intro: "{{ landing.intro | safe }}"
  pageContext: "{{ landing.h1 | safe }}"
  parentUrl: "/cakes/"
  parentLabel: "Cakes"
  breadcrumbLabel: "{{ landing.h1 | safe }}"
