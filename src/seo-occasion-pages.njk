{% if landing.key == "baby-shower" %}{% set portfolio = gallery | occasionPortfolio(landing, 11) %}{% else %}{% set portfolio = gallery | occasionPortfolio(landing, 8) %}{% endif %}{% if landing.key == "first-birthday-boys" %}{% set portfolioGalleryKey = "first-birthday-boy" %}{% elif landing.key == "first-birthday-girls" %}{% set portfolioGalleryKey = "first-birthday-girl" %}{% elif landing.key == "wedding" %}{% set portfolioGalleryKey = "wedding" %}{% elif landing.key == "engagement" %}{% set portfolioGalleryKey = "" %}{% else %}{% set portfolioGalleryKey = landing.taxonomy %}{% endif %}{% set portfolioHeading = landing.h1 + " from our studio" %}{% set portfolioIntro = landing.key | occasionPortfolioIntro %}{% include "components/seo-portfolio.njk" %}
{% if landing.key == "baby-shower" %}
{% for section in babyShowerPage.sections %}
<section class="seo-copy-block"><div><p class="eyebrow">{{ section.eyebrow }}</p><h2>{{ section.heading }}</h2><p>{{ section.lead }}</p></div><div>{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}{% if section.items %}{% for item in section.items %}<h3>{{ item.title }}</h3><p>{{ item.text }}</p>{% endfor %}{% endif %}{% if section.link %}<p><a class="text-link" href="{{ section.link.url }}">{{ section.link.label }} →</a></p>{% endif %}</div></section>
{% endfor %}
<section class="seo-copy-block"><div><p class="eyebrow">Related moments</p><h2>Related Baby Celebrations</h2><p>These celebrations are connected, but each has a different purpose and can lead to a different cake design.</p></div><div>{% for item in babyShowerPage.relatedCelebrations %}<h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p>{{ item.description }}</p>{% endfor %}</div></section>
<section class="seo-links"><div><p class="eyebrow">Continue exploring</p><h2>Related cake ideas</h2><div class="seo-link-grid">{% for item in babyShowerPage.relatedLinks %}<a href="{{ item.url }}">{{ item.label }} <span>→</span></a>{% endfor %}</div></div><div><p class="eyebrow">More guidance</p><h2>Planning another celebration?</h2><p>Explore PureBakes cakes by occasion, theme and real portfolio work, then share the date and requirement when you are ready.</p><p><a class="text-link" href="/faq/">Read Ordering FAQs →</a></p></div></section>
{% set faqs = babyShowerPage.faqs %}{% include "components/seo-faqs.njk" %}
<section class="seo-copy-block"><div><p class="eyebrow">Begin your enquiry</p><h2>Check Your Celebration Date</h2></div><div><p>{{ babyShowerPage.finalCta }}</p><button class="button button--primary" data-availability-open data-cta-location="baby_shower_final" data-occasion="baby_shower">Check Availability</button></div></section>
