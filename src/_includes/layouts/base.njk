<!doctype html><html lang="en" data-page-type="{{ pageType or 'page' }}" data-page-slug="{{ pageSlug or page.fileSlug }}"{% if pageClassification %} data-page-classification="{{ pageClassification }}"{% endif %}><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0c0916">
<title>{{ title }}</title><meta name="description" content="{{ description }}"><meta name="robots" content="{{ site.robots }}">
<link rel="canonical" href="{{ canonical or (page.url | absoluteUrl(site.productionUrl)) }}"><meta property="og:type" content="website"><meta property="og:site_name" content="PureBakes"><meta property="og:title" content="{{ title }}"><meta property="og:description" content="{{ description }}"><meta property="og:url" content="{{ canonical or (page.url | absoluteUrl(site.productionUrl)) }}"><meta property="og:image" content="{{ (socialImage or '/assets/images/site/hero-custom-cake.webp') | absoluteUrl(site.productionUrl) }}"><meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/images/brand/pure-bakes-logo-360.png"><link rel="preload" href="/assets/css/site.css" as="style"><link rel="stylesheet" href="/assets/css/site.css"><script src="/assets/js/site.js" type="module"></script>
{% if pageSlug == "areas-we-serve" %}<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css"><link rel="stylesheet" href="/assets/css/areas-map.css"><script src="/assets/vendor/leaflet/leaflet.js" defer></script><script src="/assets/js/areas-map.js" defer></script>{% endif %}
{% include "components/analytics.njk" %}
{% if structuredData %}<script type="application/ld+json">{{ structuredData | json | safe }}</script>{% endif %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":["Bakery","LocalBusiness"],"@id":"https://purebakes.in/#business","name":"PureBakes","description":"Premium custom cake studio in Hyderabad creating bespoke celebration cakes.","url":"https://purebakes.in/","telephone":"{{ business.phone.e164 }}","address":{"@type":"PostalAddress","addressLocality":"Manikonda","addressRegion":"Telangana","addressCountry":"IN"},"openingHours":"Mo-Su 09:00-21:00","sameAs":["{{ business.social.instagram }}","{{ business.social.facebook }}","{{ business.social.youtube }}"]}</script>
</head><body>{% include "components/header.njk" %}<main id="main-content">{% include "components/breadcrumb.njk" %}{{ content | safe }}</main>{% include "components/footer.njk" %}{% include "components/floating-controls.njk" %}{% include "components/availability-dialog.njk" %}</body></html>
