<section class="seo-portfolio" aria-labelledby="portfolio-title"><div class="seo-section-heading"><p class="eyebrow">Real PureBakes work</p><h2 id="portfolio-title">{{ portfolioHeading }}</h2><p>{{ portfolioIntro }}</p></div><div class="seo-cake-grid">{% for cake in portfolio %}<figure data-cake-id="{{ cake.id }}"><img class="portfolio-cake-photo" src="{{ cake.image }}" width="1080" height="1920" alt="{{ cake.alt }}" loading="lazy" decoding="async"><figcaption>{{ cake.caption }}</figcaption></figure>{% endfor %}</div><a class="text-link" href="{{ portfolioGalleryKey | gallerySearchUrl }}">View More Cakes →</a></section>
