<section class="seo-portfolio" aria-labelledby="portfolio-title">
  <div class="seo-section-heading">
    <p class="eyebrow">Real PureBakes work</p>
    <h2 id="portfolio-title">{{ portfolioHeading }}</h2>
    <p>{{ portfolioIntro }}</p>
  </div>
  <div class="seo-cake-grid">
    {% for cake in portfolio %}<figure data-cake-id="{{ cake.id }}">
      <img
        class="portfolio-cake-photo"
        src="{{ cake.image | imageVariant(360) }}"
        srcset="
          {{ cake.image | imageVariant(360) }} 360w,
          {{ cake.image | imageVariant(720) }} 720w
        "
        sizes="(max-width:47.99rem) calc(50vw - 1.2rem), (max-width:74.99rem) calc(25vw - 1.4rem), 16.5rem"
        width="1080"
        height="1920"
        alt="{{ cake.alt }}"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{{ cake.caption }}</figcaption>
    </figure>{% endfor %}
  </div>
  <a class="text-link" href="{{ portfolioGalleryKey | gallerySearchUrl }}"
    >View More Cakes →</a
  >
</section>
