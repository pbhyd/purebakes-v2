<section class="seo-faqs" aria-labelledby="faq-title"><p class="eyebrow">Helpful details</p><h2 id="faq-title">Questions before you order</h2>{% for faq in faqs %}<details><summary>{{ faq.question }}</summary><p>{{ faq.answer }}</p></details>{% endfor %}<p><a class="text-link" href="/faq/">Visit all frequently asked questions →</a></p></section><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for faq in faqs %}{"@type":"Question","name":{{ faq.question | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ faq.answer | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
