<dialog
  class="availability-dialog"
  data-availability-dialog
  aria-labelledby="availability-title"
>
  <button
    class="dialog-close"
    type="button"
    data-availability-close
    aria-label="Close availability dialog"
  >
    ×
  </button>
  <p class="eyebrow">Cake Enquiry</p>
  <h2 id="availability-title">Tell us about your celebration</h2>
  <p>
    Share your occasion and date. We'll review your requirement and get back to
    you as soon as possible.
  </p>
  <form data-availability-form>
    <fieldset class="occasion-fieldset" data-occasion-group>
      <legend>What's the occasion? <span aria-hidden="true">*</span></legend>
      <div class="occasion-options">
        <label
          ><input
            type="radio"
            name="cake-occasion"
            value="birthday"
            required
          /><span>🎂 Birthday</span></label
        ><label
          ><input type="radio" name="cake-occasion" value="anniversary" /><span
            >💐 Anniversary</span
          ></label
        ><label
          ><input type="radio" name="cake-occasion" value="engagement" /><span
            >💍 Engagement</span
          ></label
        ><label
          ><input type="radio" name="cake-occasion" value="wedding" /><span
            >💒 Wedding</span
          ></label
        ><label
          ><input type="radio" name="cake-occasion" value="baby_shower" /><span
            >🤰 Baby Shower</span
          ></label
        ><label
          ><input type="radio" name="cake-occasion" value="other" /><span
            >✨ Other</span
          ></label
        >
      </div>
      <p class="field-error" data-occasion-error aria-live="polite"></p>
    </fieldset>
    <label for="cake-date"
      >Celebration date <span aria-hidden="true">*</span></label
    ><input id="cake-date" name="cake-date" type="date" required />
    <p class="field-error" data-date-error aria-live="polite"></p>
    <button class="button button--dark" type="submit">Send Enquiry</button>
  </form>
  <p class="dialog-note">
    We'll check availability and respond as soon as we can.
  </p>
</dialog>
