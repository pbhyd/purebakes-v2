<dialog class="availability-dialog" data-availability-dialog aria-labelledby="availability-title">
  <button class="dialog-close" type="button" data-availability-close aria-label="Close availability dialog">×</button>
  <p class="eyebrow">Begin your order</p><h2 id="availability-title">When do you need your cake?</h2><p>Choose your celebration date and continue the conversation on WhatsApp.</p>
  <form data-availability-form><label for="cake-date">Date needed <span aria-hidden="true">*</span></label><input id="cake-date" name="cake-date" type="date" required><p class="field-error" data-date-error aria-live="polite"></p><button class="button button--dark" type="submit">Continue on WhatsApp</button></form>
  <p class="dialog-note">No long form. Your date and this page reference will be added to the message.</p>
</dialog>
