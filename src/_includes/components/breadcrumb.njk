{% if breadcrumbs %}<nav class="breadcrumbs wrap" aria-label="Breadcrumb"><ol>{% for crumb in breadcrumbs %}<li>{% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% else %}<span aria-current="page">{{ crumb.label }}</span>{% endif %}</li>{% endfor %}</ol></nav><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for crumb in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ crumb.label | json | safe }},"item":{{ (crumb.url or page.url) | absoluteUrl(site.productionUrl) | json | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>{% endif %}
